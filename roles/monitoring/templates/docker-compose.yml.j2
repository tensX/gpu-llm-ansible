# Managed by Ansible
# Оба экспортера в network_mode: host. Опубликованные порты Docker (ports:)
# обходят ufw, а с host-сетью доступ к портам ограничивает ufw (metrics_allowed_cidrs).
services:
  dcgm-exporter:
    image: "{{ dcgm_exporter_image }}"
    container_name: dcgm-exporter
    restart: unless-stopped
    network_mode: host
    cap_add:
      - SYS_ADMIN
    command: ["-a", ":{{ dcgm_exporter_port }}"]
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]

  node-exporter:
    image: "{{ node_exporter_image }}"
    container_name: node-exporter
    restart: unless-stopped
    network_mode: host
    pid: host
    volumes:
      - "/:/host:ro,rslave"
    command:
      - "--path.rootfs=/host"
      - "--web.listen-address=:{{ node_exporter_port }}"
